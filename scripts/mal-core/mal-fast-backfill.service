[Unit]
Description=MAL fast-box Helius backfill before 2026-09-22T00:00Z (paper only)
Documentation=https://github.com/vaanai/MAL

[Service]
Type=simple
WorkingDirectory=/home/ubuntu/mal-oos
EnvironmentFile=/var/lib/mal/fast-listener/helius.env
Environment=PYTHONUNBUFFERED=1
Environment=PYTHONPATH=/home/ubuntu/mal-oos
Environment=MAL_BACKFILL_OUT=/var/lib/mal/backfill-fast
Nice=10
CPUQuota=400%
MemoryMax=6G
ExecStart=/home/ubuntu/mal-oos/scripts/mal-core/fast-backfill.sh
Restart=on-failure
RestartSec=30

[Install]
WantedBy=default.target
