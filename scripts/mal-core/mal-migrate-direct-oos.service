[Unit]
Description=MAL frozen migrate-direct out-of-sample score (paper only, not the live runner)
Documentation=https://github.com/vaanai/MAL

[Service]
Type=oneshot
Nice=19
MemoryMax=8G
CPUQuota=150%
IOSchedulingClass=idle
WorkingDirectory=%h/mal
Environment=PYTHONUNBUFFERED=1
Environment=OMP_NUM_THREADS=1
Environment=MAL_REPO_ROOT=%h/mal
ExecStart=%h/mal/scripts/mal-core/migrate-direct-oos.sh
