[Unit]
Description=MAL forward paper books (tape tail, no keys, does not touch the recorder)
Documentation=https://github.com/vaanai/MAL

[Service]
Type=simple
Nice=19
WorkingDirectory=/var/lib/mal/paper/forward-paper/src
Environment=PYTHONUNBUFFERED=1
Environment=OMP_NUM_THREADS=1
Environment=OPENBLAS_NUM_THREADS=1
Environment=MKL_NUM_THREADS=1
Environment=NUMEXPR_NUM_THREADS=1
ExecStart=/var/lib/mal/paper/forward-paper/forward-paper.sh
Restart=on-failure
RestartSec=5

[Install]
WantedBy=default.target
