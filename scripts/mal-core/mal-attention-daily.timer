[Unit]
Description=Daily MAL attention genuine-arrival rescore (after 04:15 UTC)

[Timer]
# Host unit is disabled until the 2026-10-05 review. attention-daily.sh
# also exits before that date. Re-enable with:
#   systemctl --user enable --now mal-attention-daily.timer
OnCalendar=*-*-* 04:45:00 UTC
Persistent=true
AccuracySec=1min

[Install]
WantedBy=timers.target
