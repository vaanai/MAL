[Unit]
Description=MAL fast-host observe creates (PumpPortal WS, no key, $0), unmodified observe module
Documentation=https://github.com/vaanai/MAL
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
WorkingDirectory=/var/lib/mal/eng-observe
Nice=0
MemoryMax=1G
Environment=PYTHONPATH=/var/lib/mal/eng-observe
Environment=MAL_OBSERVE_OUTPUT_DIR=/var/lib/mal/sealed/fast-observe
Environment=MAL_LOG_LEVEL=INFO
Environment=PYTHONUNBUFFERED=1
Environment=LC_ALL=C.UTF-8
Environment=LANG=C.UTF-8
ExecStart=/var/lib/mal/fast-listener/.venv/bin/python -m observe --output-dir /var/lib/mal/sealed/fast-observe
Restart=always
RestartSec=5
StandardOutput=append:/var/lib/mal/logs/fast-observe.log
StandardError=append:/var/lib/mal/logs/fast-observe.log

[Install]
WantedBy=default.target
