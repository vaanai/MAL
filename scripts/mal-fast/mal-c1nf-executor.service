[Unit]
Description=MAL C1-NF executor (DEC-026), keyless dry-run base unit (no signing, no sending)
Documentation=https://github.com/vaanai/MAL
After=network-online.target
Wants=network-online.target
# Second wallet (DEC-026 section 4): no Conflicts= with mal-h5-executor or mal-probe-executor. Those move the H5 wallet; this unit
# moves only the c1nf-wallet credential, and starting it must never stop H5.

[Service]
Type=simple
# Its own system user, never H5's mal-live (DEC-026 note 2026-10-10, security review F2): systemd makes /run/credentials/<unit>/ readable
# by the unit's User=, so one shared user would let either executor read the other wallet's key. Helm creates mal-c1nf (runbook Step 3b).
User=mal-c1nf
Nice=10
WorkingDirectory=/usr/local/lib/mal-c1nf-exec/current
Environment=PYTHONUNBUFFERED=1
Environment=LC_ALL=C.UTF-8
Environment=LANG=C.UTF-8
# Helius key: the SAME root-only copy the probe and H5 use (/etc/mal-probe-rpc root:root 0700, helius.env root:root 0600, only the
# HELIUS_API_KEY= line). Never the ubuntu-writable /var/lib/mal/fast-listener/helius.env. No "-" prefix: a missing file fails the start.
EnvironmentFile=/etc/mal-probe-rpc/helius.env
# Root-run inline check, no file-based code. "+" lifts the sandbox for this command only. %% is systemd's escape for %.
ExecStartPre=+/usr/bin/env -i /bin/sh -c 'test "$(/usr/bin/stat -c %%u:%%g:%%a /etc/mal-probe-rpc)" = 0:0:700 && test "$(/usr/bin/stat -c %%u:%%g:%%a /etc/mal-probe-rpc/helius.env)" = 0:0:600'
# Code runs from the root-owned pinned copy only (scripts/mal-fast/install-c1nf-executor-pinned.sh). This base unit is the KEYLESS
# dry run: no --live, no LoadCredential. The live drop-in (mal-c1nf-executor-live-pinned.conf) is the only thing that hands the
# process the c1nf-wallet key.
ExecStart=/usr/local/lib/mal-c1nf-exec/venv/bin/python -I -B -u /usr/local/lib/mal-c1nf-exec/current/launcher.py --config /usr/local/lib/mal-c1nf-exec/current/c1nf-executor.json
Restart=on-failure
RestartSec=10
# Exit 2 is a deterministic start refusal (LIVE_OK missing, EXP-025 absent, end_ms unset, rpc env, key): do not hot-loop.
RestartPreventExitStatus=2
NoNewPrivileges=true
# Hardening. Writes only /var/lib/mal-live/c1nf (must exist: mal-c1nf:mal-c1nf 0700, created at provisioning). /var/lib/mal-live stays
# mal-live 0700 with one search-only ACL entry for mal-c1nf (runbook Step 3b), so the wallet-wide STOP / HALT there can be tested. H5's state dir, /etc/mal-h5, the probe key dir and H5's pinned tree are hidden outright: this
# unit neither reads nor writes anything of H5's. /var/lib/mal (runner output, sealed data) is an empty tmpfs. /home is an empty
# tmpfs; the C1-NF shadow's output directory is made visible read-only by a Helm drop-in (mal-c1nf-executor-shadow-feed.conf).
# /etc/mal-c1nf (root:root 0755, holds LIVE_OK and TIER, which Helm creates) stays readable: ProtectSystem=strict makes /etc
# read-only, not hidden. It is not under ReadWritePaths, so this process can neither create nor remove LIVE_OK.
ProtectSystem=strict
ReadWritePaths=/var/lib/mal-live/c1nf
ReadOnlyPaths=/usr/local/lib/mal-c1nf-exec
InaccessiblePaths=-/var/lib/mal-live/h5 -/etc/mal-h5 -/etc/mal-probe -/usr/local/lib/mal-h5-exec
TemporaryFileSystem=/var/lib/mal:ro
ProtectHome=tmpfs
PrivateTmp=true
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectControlGroups=true
RestrictSUIDSGID=true
LockPersonality=true
RestrictAddressFamilies=AF_INET AF_INET6
CapabilityBoundingSet=
PrivateDevices=true
ProtectProc=invisible
SystemCallFilter=@system-service
SystemCallArchitectures=native
RestrictNamespaces=true
RestrictRealtime=true
ProtectClock=true
ProtectKernelLogs=true
ProtectHostname=true
UMask=0077
LimitCORE=0
MemoryMax=1G
MemorySwapMax=0

[Install]
WantedBy=multi-user.target
