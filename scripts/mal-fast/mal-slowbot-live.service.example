# EXAMPLE ONLY. Not installed by merging this file. Only the manager starts a lane book; Helm installs the unit and the credential
# (DEC-035). This file holds no key. The DRY default below signs and sends nothing. The live switch is the drop-in at the bottom.
#
# Install sketch (Helm, from a root-owned pinned copy of the repo, as for the H5 lane units; see scripts/mal-fast/install-h5-executor-pinned.sh):
#   /etc/systemd/system/mal-slowbot-live.service
#   /etc/systemd/system/mal-slowbot-live.service.d/live.conf   (the drop-in below; creating it is the live switch)
#   /etc/mal-slowbot/LIVE_OK                                   (root-created; absent = the executor refuses --live)
#   /var/lib/mal-live/slowbot-h/{intents,state}                (mal-live 0700; intents/ also writable by the research-0 push user)
[Unit]
Description=MAL slowbot H arm, DEC-035 live-learning lane executor (example; DRY by default)
After=network-online.target
Wants=network-online.target
# One wallet, one signer at a time: never alongside another unit that holds the lane key.
After=mal-h5-lane-executor.service

[Service]
Type=simple
User=mal-live
Nice=10
WorkingDirectory=/usr/local/lib/mal-slowbot/current
Environment=PYTHONUNBUFFERED=1
Environment=LC_ALL=C.UTF-8
# Helius RPC key for the key holder: the same root-only copy the H5 lane unit uses; only the HELIUS_API_KEY= line.
EnvironmentFile=/etc/mal-probe-rpc/helius.env
ExecStart=/usr/local/lib/mal-h5-exec/venv/bin/python -I -B -u -m tools.slowbot.live_executor --config /usr/local/lib/mal-slowbot/current/slowbot-live.json
Restart=on-failure
RestartSec=10
RestartPreventExitStatus=2
NoNewPrivileges=true
ProtectSystem=strict
ReadWritePaths=/var/lib/mal-live/slowbot-h /var/lib/mal-live/h5-lane
ReadOnlyPaths=/usr/local/lib/mal-slowbot /etc/mal-slowbot
ProtectHome=tmpfs
PrivateTmp=true
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectControlGroups=true
RestrictSUIDSGID=true
LockPersonality=true
RestrictAddressFamilies=AF_INET AF_INET6
CapabilityBoundingSet=
PrivateDevices=true
ProtectProc=invisible
SystemCallFilter=@system-service
SystemCallArchitectures=native
RestrictNamespaces=true
UMask=0077
LimitCORE=0
MemoryMax=1G
MemorySwapMax=0

[Install]
WantedBy=multi-user.target

# ---- live drop-in: /etc/systemd/system/mal-slowbot-live.service.d/live.conf (separate file; hands the process the key, with dry_run=false in the config) ----
# [Service]
# LoadCredential=probe-wallet:/etc/mal-probe/probe-wallet.json
# ExecStart=
# ExecStart=/usr/local/lib/mal-h5-exec/venv/bin/python -I -B -u -m tools.slowbot.live_executor --config /usr/local/lib/mal-slowbot/current/slowbot-live.json --live
