[Unit]
Description=MAL r4-b-T C0 paper twin writer (scripts/mal-fast/r4bt-c0-twin.sh --loop; tools/r4bt_c0_twin.py), PAPER ONLY: no credential, no network, reads the derived tape copy
Documentation=https://github.com/vaanai/MAL/blob/main/docs/runbooks/r4bt-c0-executor.md
# The twin writes twins.jsonl and twins.run.json into the executor's state dir. The executor's twin gate accepts those files only when they are ROOT-OWNED and not
# group/other writable (tools/r4bt_c0_executor._read_small, root_checks), so this unit runs as root with an EMPTY capability set: it reads the derived copy only through the
# ACL Helm grants (runbook section 2) and writes only the state dir. If the manager wants another uid, the executor's owner rule changes first (open question on the PR).
# Template placeholder: <AT-EVENT:feed_delay_slots> = d, the whole number of slots pinned in the registration record. Substituted by Helm at install (runbook section 3).
# Not enabled or started before Am.9 (a4). The derived copy's writer must keep verified hours >= 400 h (--keep-verified-h 400; run `r4bt-c0-twin.sh --check-tape`).
[Service]
Type=simple
User=root
Group=root
Nice=19
IOSchedulingClass=idle
WorkingDirectory=/opt/mal-r4b-c0/current
Environment=LC_ALL=C.UTF-8
Environment=LANG=C.UTF-8
Environment=R4BT_C0_REPO=/opt/mal-r4b-c0/current
Environment=R4BT_W_SHA=17e3b05a7696900cda7fcf93e4af4008d8fa0184
Environment=R4BT_C0_TWIN_SHA256=d3c10430b04264b5de9ea15c8ab29b6db2b3c3bf89643181faef8266f7d1b395
Environment=R4BT_FEED_DELAY_SLOTS=<AT-EVENT:feed_delay_slots>
Environment=R4BT_C0_ORDERS=/var/lib/mal-r4b-c0/state/r4bt-order-ledger.jsonl
Environment=R4BT_C0_STATE_DIR=/var/lib/mal-r4b-c0/state
Environment=R4BT_C0_PYTHON=/opt/mal-r4b-c0/venv/bin/python
Environment=R4BT_C0_INTERVAL=300
ExecStartPre=/bin/sh /opt/mal-r4b-c0/current/scripts/mal-fast/r4bt-c0-twin.sh --check
ExecStart=/bin/sh /opt/mal-r4b-c0/current/scripts/mal-fast/r4bt-c0-twin.sh --loop
Restart=on-failure
RestartSec=60
NoNewPrivileges=true
PrivateNetwork=true
RestrictAddressFamilies=AF_UNIX
ProtectSystem=strict
ReadWritePaths=/var/lib/mal-r4b-c0/state
ReadOnlyPaths=/opt/mal-r4b-c0
TemporaryFileSystem=/var/lib/mal:ro
TemporaryFileSystem=/data:ro
ProtectHome=tmpfs
# The derived copy, read-only: closed tape files, .writer/counts.jsonl, .push/verified.json. NOT the live tip dir, the archive, .writer/state.json or the declog.
BindReadOnlyPaths=/home/claude/mal-data/arena-tipfeed/tape
InaccessiblePaths=-/etc/mal-probe -/etc/mal-probe-rpc -/etc/mal-h5-arena-key -/etc/mal-hv4-c0-key -/etc/mal-r4b-c0-key -/etc/mal-r4bt-c0-key
PrivateTmp=true
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectControlGroups=true
RestrictSUIDSGID=true
LockPersonality=true
CapabilityBoundingSet=
PrivateDevices=true
ProtectProc=invisible
SystemCallFilter=@system-service
SystemCallArchitectures=native
RestrictNamespaces=true
RestrictRealtime=true
ProtectClock=true
ProtectKernelLogs=true
ProtectHostname=true
UMask=0022
LimitCORE=0
MemoryMax=4G
MemorySwapMax=0

[Install]
WantedBy=multi-user.target
