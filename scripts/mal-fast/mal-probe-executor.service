[Unit]
Description=MAL DEC-019 execution probe, keyless dry-run executor (no signing, no sending)
Documentation=https://github.com/vaanai/MAL
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=mal-live
Nice=10
WorkingDirectory=/var/lib/mal/fast-forward/src
Environment=PYTHONUNBUFFERED=1
Environment=LC_ALL=C.UTF-8
Environment=LANG=C.UTF-8
# Helius key for the key holder: a ROOT-ONLY copy (/etc/mal-probe-rpc root:root 0700, helius.env root:root 0600, only the
# HELIUS_API_KEY= line). systemd reads it as root, so it must never be a file the ubuntu paper side can write (that one,
# /var/lib/mal/fast-listener/helius.env, stays ubuntu:ubuntu 0600 for paper). No "-" prefix: a missing file fails the start.
EnvironmentFile=/etc/mal-probe-rpc/helius.env
# Root-run inline check, no file-based code (nothing ubuntu-writable may run as root). "+" lifts the sandbox for this
# command only, so SystemCallFilter/CapabilityBoundingSet=/NoNewPrivileges do not apply to it. %% is systemd's escape for %.
ExecStartPre=+/bin/sh -c 'test "$(stat -c %%u:%%g:%%a /etc/mal-probe-rpc)" = 0:0:700 && test "$(stat -c %%u:%%g:%%a /etc/mal-probe-rpc/helius.env)" = 0:0:600'
ExecStart=/var/lib/mal/fast-forward/venv/bin/python -m tools.probe_executor --config /var/lib/mal/fast-forward/src/scripts/mal-fast/probe-executor.json
Restart=on-failure
RestartSec=10
NoNewPrivileges=true
# Hardening. Writes only /var/lib/mal-live (must exist: mal-live, 0700, created at provisioning). Reads the runner's intents log (in the paper
# output dir) and nothing else of the runner: the other runner files are hidden (forward-read seal).
ProtectSystem=strict
ReadWritePaths=/var/lib/mal-live
ReadOnlyPaths=/var/lib/mal/fast-forward
# Seal by WHITELIST (a denylist misses new runner files): the runner output dir is replaced by an
# empty tmpfs and ONLY intents.jsonl is bound back in, read-only. Verify once on host that the
# bind survives the runner's daily restart (same inode, appended in place).
TemporaryFileSystem=/var/lib/mal/paper/fast-forward-paper:ro
BindReadOnlyPaths=-/var/lib/mal/paper/fast-forward-paper/intents.jsonl
InaccessiblePaths=/var/lib/mal/sealed
ProtectHome=true
PrivateTmp=true
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectControlGroups=true
RestrictSUIDSGID=true
LockPersonality=true
RestrictAddressFamilies=AF_INET AF_INET6
CapabilityBoundingSet=
PrivateDevices=true
ProtectProc=invisible
SystemCallFilter=@system-service
MemoryMax=1G
MemorySwapMax=0

[Install]
WantedBy=multi-user.target
