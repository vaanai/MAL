 "fields": {
  "b": "base_reserve",
  "construction": "how sol was built (verified by the EXP-025 tests)",
  "expect": "hit | miss | skipped | excluded:<cause>",
  "in_denominator": "true for hit and miss",
  "ppm": "the tier both helpers give at (q + v, b)",
  "q": "EXP-025: adapter quote_reserve (mapped); EXP-024: tape quote_reserve",
  "qin, dev_e6": "derived, for hit and miss cases only",
  "sol": "sol_lamports",
  "tok": "token_raw",
  "v": "EXP-025: tokens.v0_lamports; EXP-024: V"
 },
 "note": "No case is both excluded and skipped: EXP-025 decides the exclusion first (from the sampled raw row), EXP-024 applies the skip rule first (on tape fields) and then the exclusion (from the raw decode). For such a print the two tools would count it in different buckets, and both leave it out of the denominator. Synthetic integers only; no October or tape row.",
 "rule": "P7 line 2 (fee tier), buy side, amended (EXP-025 Amendment 7 B; EXP-024 Amendment 7 B). Comparable buy: no zero_sol and ix_name exactly 'buy' or 'buy_v2' (causes in order: zero_sol, buy_exact_quote_in prefix, no_ix_name, ix_not_listed). Skip rule: sol <= 0, tok <= 0 or tok >= b. Relation: Q = q + v; qin = -((-Q*tok) // (b - tok)); ppm = the tier at (Q, b); hit iff abs(sol*10**6 - qin*(10**6 + ppm)) <= 100*qin. All integers.",
 "schema": "p7_line2_buy_cases_v1"
}
