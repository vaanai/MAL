[Unit]
Description=MAL status file for mal-research-0 (units view), one read-only SSH round trip
Documentation=https://github.com/vaanai/MAL

[Service]
Type=oneshot
WorkingDirectory=%h/MAL
ExecStart=/usr/bin/python3 -m tools.mal_status --out-dir %h/data/status --remote research
TimeoutStartSec=60
Nice=10
