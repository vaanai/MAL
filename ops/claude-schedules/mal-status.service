[Unit]
Description=MAL status file for this host, for the Console (read-only)
Documentation=https://github.com/vaanai/MAL

[Service]
Type=oneshot
WorkingDirectory=%h/MAL
ExecStart=/usr/bin/python3 -m tools.mal_status --out-dir %h/data/status
ExecStart=/usr/bin/python3 -m tools.mal_credit_log --log-path %h/data/credits/helius-credits.jsonl
TimeoutStartSec=60
Nice=10
